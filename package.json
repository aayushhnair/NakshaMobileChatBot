{
  "name": "naksha-jathakam",
  "version": "1.0.0",
  "description": "Naksha — Personalized Vedic Astrology Soulmate App for Ayush V Nair",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:web": "esbuild scripts/astrology-browser-entry.js --bundle --format=iife --outfile=public/js/astrology-engine.bundle.js",
    "build:android": "npm run build:web && npx cap sync android && cd android && ./gradlew assembleDebug",
    "open:android": "npx cap open android"
  },
  "keywords": [
    "jathakam",
    "vedic-astrology",
    "naksha",
    "pwa"
  ],
  "author": "Ayush V Nair",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
